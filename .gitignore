# Portfolio Arquitectura - .gitignore

# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# Testing
coverage/
.nyc_output/
*.lcov

# Production builds
build/
dist/
out/
.next/

# Sanity
studio/dist/
studio/.sanity/

# Environment variables
.env
.env*.local
!.env.local.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Deployment
.vercel
.netlify

# Debug
.vscode-test

# Temporary files
*.tmp
*.temp
.cache/

# Misc
*.seed
*.pid.lock
